# ─────────────────────────────────────────────────────────────
#  Repto — Omgevingsvariabelen
#  Kopieer dit bestand naar .env en vul de waarden in
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL EU) ────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── WhatsApp (Meta Cloud API) ────────────────────────────────
# Aanvragen via: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_VERIFY_TOKEN=repto_webhook_verify_geheim
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_VERSION=v22.0
# Optioneel: app-secret voor X-Hub-Signature-256 verificatie van inkomende webhooks
WHATSAPP_APP_SECRET=
# Goedgekeurde template voor afspraakherinneringen (3 body-params: naam, bedrijf, datum/tijd)
WHATSAPP_REMINDER_TEMPLATE=appointment_reminder
WHATSAPP_REMINDER_TEMPLATE_LANG=nl

# ── AI (Anthropic Claude) ────────────────────────────────────
# Aanvragen via: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── Auth (Clerk) ─────────────────────────────────────────────
# Aanvragen via: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# ── Betalingen (Stripe) ──────────────────────────────────────
# Aanvragen via: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ── E-mail (Resend) ──────────────────────────────────────────
# Aanvragen via: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Contactformulier (repto.be/contact). Afzender moet op een in Resend
# geverifieerd domein staan. Zonder RESEND_API_KEY toont het formulier
# de bezoeker het directe e-mailadres als fallback.
CONTACT_EMAIL=Info@repto.be
CONTACT_FROM=Repto website <contact@repto.be>

# ── E-mail-intake (increment 2b — Resend Inbound) ────────────
# Inkomende mail komt via een Resend Inbound webhook op POST /webhooks/email.
# RESEND_WEBHOOK_SECRET = de Svix-signing-secret (whsec_...) uit het Resend-dashboard.
# EMAIL_INTAKE_DOMAIN = (sub)domein met MX naar Resend; org via plus-addressing
#   intake+{org_id}@<domein>. EMAIL_INTAKE_FROM = afzender van de opvolgmail.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
EMAIL_INTAKE_DOMAIN=inbound.repto.be
EMAIL_INTAKE_FROM=Repto <intake@repto.be>

# ── Web-form intake (increment 2) ────────────────────────────
# De demoaanvraag op repto.be wordt server-side doorgestuurd naar het backend
# web-form-intake-endpoint, zodat elke aanvraag een echte lead wordt. Beide leeg
# laten = enkel de marketingmail (geen lead-capture). org_id blijft server-side
# (browser ziet het nooit). REPTO_API_URL = basis-URL van de FastAPI-backend.
REPTO_API_URL=https://repto-claude-setup.up.railway.app
REPTO_INTAKE_ORG_ID=

# ── Google (Sheets + Calendar) ───────────────────────────────
# OAuth2 app aanmaken via: https://console.cloud.google.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# ── App instellingen ─────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
# Canoniek publiek domein van de web-app (sitemap, robots, OG-tags).
# Valt in code terug op https://repto.be indien niet gezet.
NEXT_PUBLIC_SITE_URL=https://repto.be